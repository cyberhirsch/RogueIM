import { ListView, ScrollView } from "std-widgets.slint";
import { Theme, RButton, RInput, OsIcon, RCheck, RTab, RCaption, RArea, RMenuItem, Tip, TipLayer } from "theme.slint";
import { ChatPane, ChatLine, TButton } from "chat.slint";
import { LoginScreen } from "login.slint";
export { ChatWindow, ChatLine } from "chat.slint";
export { ScreenWindow } from "screen.slint";
export { Theme } from "theme.slint";

export struct ContactRow {
    // "contact", "group", "notes", "folder"
    kind: string,
    id: string,
    name: string,
    status: string,
    tint: color,
    badge: string,
    os: string,
    device: string,
    battery: bool,
    unread: int,
    awaiting: bool,
    away: string,
    verified: bool,
    typing: bool,
    bot: bool,
    collapsed: bool,
    count: int,
    music: string,
    // other online devices, shown on hover
    devs: string,
}

export struct PendingRow { id: string, nick: string, fp: string, text: string, introduced-by: string, warning: string }
export struct IntroRow { index: int, name: string, from: string, verified: bool }
export struct InviteRow { token: string, label: string, info: string, code: string }
export struct DeviceRow { peer: string, name: string, os: string, device: string, status: string, tint: color, manager: bool, this: bool, info: string }
export struct PickRow { id: string, name: string, checked: bool }
export struct SearchRow { id: string, name: string, time: string, text: string }
export struct MemberRow { account: string, name: string, admin: bool }

export struct GadgetItem { kind: string, id: string, text: string, hint: string, value: float, checked: bool }
export struct GadgetRow { items: [GadgetItem] }
export struct Gadget { id: string, name: string, collapsed: bool, rows: [GadgetRow] }
export struct PluginRow { id: string, name: string, description: string, caps: string, enabled: bool, installed: bool, usage: string, first: bool, last: bool }
export struct ListRow { kind: string, id: string, name: string }
export struct SoundRow { label: string, on: bool, source: string }

// One element of a plugin's section, drawn by RogueIM (plugins never render).
component GadgetItemView inherits Rectangle {
    in property <GadgetItem> item;
    callback click();
    callback input(string);
    callback check(bool);
    min-height: 18px;
    horizontal-stretch: root.item.kind == "button" ? 0 : 1;
    if root.item.kind == "title": Text { x: 0; width: parent.width; text: root.item.text; color: Theme.accent; font-size: Theme.small; font-weight: 700; vertical-alignment: center; horizontal-alignment: left; overflow: elide; }
    if root.item.kind == "text": Text { x: 0; width: parent.width; text: root.item.text; color: Theme.fg; font-size: Theme.small; vertical-alignment: center; horizontal-alignment: left; overflow: elide; }
    if root.item.kind == "dim": Text { x: 0; width: parent.width; text: root.item.text; color: Theme.dim; font-size: 10px; vertical-alignment: center; horizontal-alignment: left; wrap: word-wrap; }
    if root.item.kind == "button": RButton { text: root.item.text; clicked => { root.click(); } }
    if root.item.kind == "input": RInput {
        text: root.item.text;
        placeholder: root.item.hint;
        password: root.item.id == "pass";
        accepted(t) => { root.input(t); }
    }
    if root.item.kind == "progress": Rectangle {
        y: (parent.height - 5px) / 2;
        height: 5px;
        background: Theme.line;
        Rectangle { x: 0; width: parent.width * max(0.0, min(1.0, root.item.value)); background: Theme.accent; }
    }
    if root.item.kind == "check": RCheck { x: 0; width: parent.width; text: root.item.text; checked: root.item.checked; toggled(v) => { root.check(v); } }
}


export component MainWindow inherits Window {
    title: "RogueIM";
    icon: @image-url("../assets/icon.png");
    preferred-width: 280px;
    preferred-height: 640px;
    min-width: 4px;
    min-height: 200px;
    no-frame: root.docked;
    always-on-top: true;
    background: Theme.bg;
    default-font-family: Theme.font;
    default-font-size: Theme.fs;

    // ---------------------------------------------------------------- state
    in property <bool> logged-in;
    in property <bool> new-account;
    in property <bool> busy;
    in property <string> login-error;
    in property <string> profile;
    in-out property <string> restore-path;
    in property <string> login-stage;
    in property <string> recovery-words;
    in property <string> link-code;
    in property <string> link-words;
    in property <bool> collapsed;

    in property <string> my-nick;
    in property <string> my-fp;
    in property <string> my-os;
    in property <string> my-device;
    in property <string> my-status;
    in property <color> my-tint;
    in property <string> my-badge;
    in property <[string]> status-labels;

    in property <[ContactRow]> contacts;
    in property <[PendingRow]> pending;
    in property <[IntroRow]> intros;
    in property <[InviteRow]> invites;
    in property <[DeviceRow]> devices;
    in property <[PickRow]> pick-rows;
    in property <[SearchRow]> results;
    in property <[string]> folders;
    in property <string> invite;
    in property <string> notice;
    in property <bool> docked;
    in property <bool> can-move-left;
    in property <bool> can-move-right;
    in property <bool> dock-left;
    in-out property <string> s-bar-width: "280";
    in property <string> theme-name;
    in property <[string]> theme-names;
    in-out property <string> away-msg;
    // 0 none, 1 add, 2 invite, 3 settings, 4 search, 5 new group, 6 contact, 7 group
    in-out property <int> panel: 0;
    in-out property <int> settings-tab: 0;
    in-out property <float> split: 0.5;
    in-out property <int> invite-kind: 0;

    // settings (edited in place, applied by callbacks)
    in-out property <bool> s-auto-reply;
    in-out property <bool> s-read-receipts;
    in-out property <bool> s-hide-offline;
    in-out property <bool> s-sounds: true;
    in-out property <bool> s-notify: true;
    in-out property <bool> s-popups: true;
    in-out property <bool> s-autostart;
    in-out property <bool> s-autohide;
    in-out property <string> s-auto-away: "10";
    in-out property <string> s-auto-na: "30";
    in-out property <string> s-lock-idle: "0";
    in-out property <string> s-relays;
    in-out property <string> s-bootstrap;
    in-out property <bool> s-lan-only;
    in-out property <bool> s-helper;
    in-out property <bool> s-public-helpers: true;
    in-out property <string> s-backup-dir;
    in-out property <string> s-backup-hours: "24";
    in-out property <string> s-backup-keep: "5";
    in-out property <string> s-about;
    in-out property <string> s-location;
    in-out property <string> s-homepage;
    in-out property <string> s-interests;
    in property <string> net-info;
    in property <bool> is-manager;
    in property <string> hotkeys-info;
    in-out property <string> link-input;
    in property <string> link-check-words;
    in-out property <bool> remember;
    in-out property <string> invite-n: "5";
    in-out property <bool> s-start-min;
    in-out property <bool> s-typing: true;
    in-out property <bool> s-notify-online: true;
    in property <[SoundRow]> sound-rows;
    in-out property <string> s-hk-toggle;
    in-out property <string> s-hk-reply;
    in-out property <string> s-hk-notes;
    in-out property <string> s-hk-away;
    in-out property <string> s-hk-dnd;
    in-out property <string> s-nick;
    in-out property <string> s-bandwidth: "0";
    in-out property <string> s-link-days;
    in property <[ListRow]> list-rows;
    in-out property <string> folder-edit;
    in-out property <string> folder-edit-text;
    in property <string> plugin-confirm;
    in property <string> plugin-confirm-text;
    in-out property <bool> s-update-check: true;
    in-out property <bool> s-update-auto;
    // "", "available", "busy", "ready"
    in property <string> update-state;
    in property <string> update-text;
    in property <string> update-status;
    // "", "calling", "ringing", "active"
    in property <string> call-state;
    in property <string> call-text;
    in property <bool> call-muted;
    in property <bool> call-screen-out;
    in property <bool> call-screen-in;
    in property <bool> call-viewer-open;
    // "" with one monitor, else e.g. "screen 1/2"
    // number of screens that can be shared, and the chosen one (0-based)
    in property <int> call-monitors;
    in property <int> call-monitor;
    in property <string> dchat-call-state;

    // contact details
    in-out property <string> d-id;
    in-out property <string> d-name;
    in property <string> d-fp;
    in property <string> d-safety;
    in-out property <bool> d-verified;
    in-out property <int> d-visibility;
    in-out property <bool> d-ignored;
    in-out property <string> d-folder;
    in-out property <bool> d-urgent;
    in-out property <int> d-disappearing;
    in-out property <bool> d-notify;
    in-out property <bool> d-auto;
    in property <string> d-introduced;
    in property <string> d-profile;
    in property <string> d-devices;

    // group details
    in-out property <string> g-id;
    in-out property <string> g-name;
    in property <bool> g-admin;
    in property <[MemberRow]> g-members;

    // docked chat
    in property <bool> chat-docked;
    in property <string> dchat-id;
    in property <string> dchat-mode: "contact";
    in property <string> dchat-name;
    in property <string> dchat-status;
    in property <color> dchat-tint;
    in property <string> dchat-os;
    in property <string> dchat-device;
    in property <string> dchat-badge;
    in property <string> dchat-away;
    in property <string> dchat-info;
    in property <bool> dchat-typing;
    in property <bool> dchat-authorized: true;
    in property <[ChatLine]> dchat-lines;

    // plugins
    in property <[Gadget]> gadgets;
    in property <[PluginRow]> plugins;
    in property <bool> can-task;

    // ---------------------------------------------------------------- callbacks
    callback create(string, string, string);
    callback unlock(string);
    callback start-link(string);
    callback browse-backup();
    callback restore(string, bool, string, string);
    callback recovery-done();
    callback copy-text(string);

    callback set-status(int);
    callback new-invite(int, string);
    callback revoke-invite(string);
    callback add-contact(string, string);
    callback accept(string);
    callback deny(string);
    callback accept-intro(int, bool);
    callback dismiss-intro(int);
    callback open-chat(string);
    callback select-contact(string);
    callback open-notes();
    callback open-group(string);
    callback toggle-folder(string);
    callback show-details(string);
    callback show-group(string);
    callback remove-contact(string);
    callback move-dock(int);
    callback quit();
    callback set-theme(string);
    callback setting-toggled(string);
    callback save-general();
    callback save-network();
    callback save-backup();
    callback save-profile();
    callback backup-now();
    callback browse-backup-dir();
    callback new-recovery-key();
    callback import-history();
    callback link-changed();
    callback link-device(bool, bool, string);
    callback device-remove(string, bool);
    callback device-lock(string);
    callback wipe-account();
    callback search(string);
    callback pick-toggle(string);
    callback create-group(string);
    callback detail-save();
    callback detail-safety();
    callback detail-introduce(string);
    callback group-rename();
    callback group-add(string);
    callback group-remove(string);
    callback group-leave();
    callback expand();

    callback dchat-send(string, bool, string);
    callback dchat-typed();
    callback dchat-line-action(string, string);
    callback dchat-edit(string, string);
    callback dchat-file-send();
    callback dchat-file-action(string, string);
    callback dchat-undock();
    callback dchat-close();
    callback split-changed(float);
    callback gadget-click(string, string);
    callback gadget-input(string, string, string);
    callback gadget-check(string, string, bool);
    callback gadget-collapse(string);
    callback plugin-toggle(string, bool);
    callback plugin-enable(string);
    callback plugin-cancel();
    callback plugin-move(string, int);
    callback save-hotkeys();
    callback bar-resized(length);
    callback update-install();
    callback update-later();
    callback update-restart();
    callback update-check-now();
    callback call-accept();
    callback call-decline();
    callback call-hangup();
    callback call-mute();
    callback call-share();
    callback call-view();
    callback call-monitor-pick(int);
    callback dchat-call-toggle();
    callback sound-toggle(int, bool);
    callback sound-cycle(int, int);
    callback sound-pick(int);
    callback sound-play(int);
    callback list-clear(string, string);
    callback folder-move(string, int);
    callback folder-delete(string);
    callback folder-rename(string, string);

    // ---------------------------------------------------------------- auto-hide strip
    if root.collapsed: Rectangle {
        background: Theme.accent;
        TouchArea {
            changed has-hover => {
                if (self.has-hover) { root.expand(); }
            }
            clicked => { root.expand(); }
        }
    }

    // ---------------------------------------------------------------- login
    if !root.logged-in && !root.collapsed: LoginScreen {
        new-account: root.new-account;
        busy: root.busy;
        error: root.login-error;
        profile: root.profile;
        restore-path <=> root.restore-path;
        stage: root.login-stage;
        recovery-words: root.recovery-words;
        link-code: root.link-code;
        link-words: root.link-words;
        remember <=> root.remember;
        create(n, a, b) => { root.create(n, a, b); }
        unlock(p) => { root.unlock(p); }
        start-link(p) => { root.start-link(p); }
        browse-backup => { root.browse-backup(); }
        restore(a, b, c, d) => { root.restore(a, b, c, d); }
        recovery-done => { root.recovery-done(); }
        copy-text(t) => { root.copy-text(t); }
    }

    // ---------------------------------------------------------------- main
    if root.logged-in && !root.collapsed: VerticalLayout {
        padding: 6px;
        spacing: 5px;

        // header: me
        Rectangle {
            height: 44px;
            vertical-stretch: 0;
            border-width: 1px;
            border-color: Theme.line;
            background: Theme.panel;
            HorizontalLayout {
                padding: 6px;
                spacing: 8px;
                OsIcon { os: root.my-os; device: root.my-device; tint: root.my-tint; badge: root.my-badge; y: 2px; }
                VerticalLayout {
                    Text { text: root.my-nick; color: Theme.fg; font-weight: 700; overflow: elide; }
                    Text {
                        text: root.my-status + " ▾";
                        color: root.my-tint;
                        font-size: Theme.small;
                        TouchArea { mouse-cursor: pointer; clicked => { status-popup.show(); } }
                    }
                }
            }
            status-popup := PopupWindow {
                x: 44px;
                y: 40px;
                width: 150px;
                Rectangle {
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: Theme.fg;
                    VerticalLayout {
                        padding: 4px;
                        for label[i] in root.status-labels: RMenuItem { text: label; clicked => { root.set-status(i); } }
                    }
                }
            }
        }

        // toolbar
        HorizontalLayout {
            spacing: 1px;
            vertical-stretch: 0;
            TButton { glyph: "+"; tip: "add a contact (paste their invite)"; active: root.panel == 1; clicked => { root.panel = root.panel == 1 ? 0 : 1; } }
            TButton { glyph: "@"; tip: "invite someone: make a code to send them"; active: root.panel == 2; clicked => { root.panel = root.panel == 2 ? 0 : 2; } }
            TButton { glyph: "#"; tip: "new group chat"; active: root.panel == 5; clicked => { root.panel = root.panel == 5 ? 0 : 5; } }
            TButton { glyph: "?"; tip: "search all chats"; active: root.panel == 4; clicked => { root.panel = root.panel == 4 ? 0 : 4; } }
            TButton { glyph: "⚙"; tip: "settings"; active: root.panel == 3; clicked => { root.panel = root.panel == 3 ? 0 : 3; } }
            Rectangle { }
            TButton { glyph: "<"; tip: "move the bar one screen edge to the left"; clicked => { if (root.can-move-left) { root.move-dock(-1); } } }
            TButton { glyph: ">"; tip: "move the bar one screen edge to the right"; clicked => { if (root.can-move-right) { root.move-dock(1); } } }
            TButton { glyph: "x"; danger: true; tip: "quit RogueIM"; clicked => { root.quit(); } }
        }

        // ------------------------------------------------ panel: add contact / introductions
        if root.panel == 1: Rectangle {
            vertical-stretch: 0;
            border-width: 1px;
            border-color: Theme.dim;
            VerticalLayout {
                padding: 6px;
                spacing: 4px;
                Text { text: "> add contact"; color: Theme.accent; font-size: Theme.small; }
                inv := RInput { placeholder: "paste rim2:… invite"; }
                msg := RInput { placeholder: "request message"; text: "Please add me to your list."; }
                HorizontalLayout {
                    spacing: 4px;
                    alignment: start;
                    RButton { text: "request auth"; clicked => { root.add-contact(inv.text, msg.text); inv.text = ""; root.panel = 0; } }
                    RButton { text: "close"; tone: Theme.dim; clicked => { root.panel = 0; } }
                }
                if root.intros.length > 0: RCaption { text: "introductions from your contacts (add+trust: take over their verification):"; wrap: word-wrap; }
                for it in root.intros: HorizontalLayout {
                    spacing: 4px;
                    Text { text: it.name + " (by " + it.from + (it.verified ? ", verified" : "") + ")"; color: Theme.fg; font-size: Theme.small; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                    RButton { text: "add"; clicked => { root.accept-intro(it.index, false); } }
                    if it.verified: RButton { text: "add+trust"; clicked => { root.accept-intro(it.index, true); } }
                    RButton { text: "x"; tone: Theme.dim; clicked => { root.dismiss-intro(it.index); } }
                }
            }
        }

        // ------------------------------------------------ panel: invites
        if root.panel == 2: Rectangle {
            vertical-stretch: 0;
            border-width: 1px;
            border-color: Theme.dim;
            VerticalLayout {
                padding: 6px;
                spacing: 4px;
                Text { text: "> invite"; color: Theme.accent; font-size: Theme.small; }
                HorizontalLayout {
                    spacing: 2px;
                    alignment: start;
                    RTab { text: "once"; active: root.invite-kind == 0; clicked => { root.invite-kind = 0; } }
                    RTab { text: "N×"; active: root.invite-kind == 1; clicked => { root.invite-kind = 1; } }
                    RTab { text: "24h"; active: root.invite-kind == 2; clicked => { root.invite-kind = 2; } }
                    RTab { text: "7d"; active: root.invite-kind == 3; clicked => { root.invite-kind = 3; } }
                    RTab { text: "∞"; active: root.invite-kind == 4; clicked => { root.invite-kind = 4; } }
                }
                if root.invite-kind == 1: HorizontalLayout {
                    spacing: 4px;
                    RCaption { text: "uses:"; vertical-alignment: center; }
                    RInput { text <=> root.invite-n; width: 50px; }
                    Rectangle { }
                }
                ilabel := RInput { placeholder: "label (who is it for?)"; }
                RButton { text: "create invite"; clicked => { root.new-invite(root.invite-kind, ilabel.text); } }
                if root.invite != "": Rectangle {
                    height: 56px;
                    clip: true;
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: Theme.line;
                    TextInput {
                        x: 4px; y: 4px;
                        width: parent.width - 8px; height: parent.height - 8px;
                        text: root.invite;
                        read-only: true;
                        single-line: false;
                        wrap: char-wrap;
                        color: Theme.dim;
                        font-size: 9px;
                        selection-background-color: Theme.accent;
                    }
                }
                if root.invite != "": HorizontalLayout {
                    spacing: 4px;
                    alignment: start;
                    RButton { text: "copy"; clicked => { root.copy-text(root.invite); } }
                    RButton { text: "close"; tone: Theme.dim; clicked => { root.panel = 0; } }
                }
                if root.invites.length > 0: RCaption { text: "active invites:"; }
                for i in root.invites: HorizontalLayout {
                    spacing: 4px;
                    Text { text: (i.label == "" ? "(no label)" : i.label) + " · " + i.info; color: Theme.fg; font-size: 10px; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                    RButton { text: "copy"; clicked => { root.copy-text(i.code); } }
                    RButton { text: "revoke"; tone: Theme.red; clicked => { root.revoke-invite(i.token); } }
                }
            }
        }

        // ------------------------------------------------ panel: search
        if root.panel == 4: Rectangle {
            vertical-stretch: 0;
            border-width: 1px;
            border-color: Theme.dim;
            VerticalLayout {
                padding: 6px;
                spacing: 4px;
                q := RInput { placeholder: "search all chats…"; accepted(t) => { root.search(t); } edited => { root.search(q.text); } }
                for r in root.results: Rectangle {
                    height: 30px;
                    background: rta.has-hover ? Theme.hover : transparent;
                    VerticalLayout {
                        Text { text: r.name + "  " + r.time; color: Theme.accent; font-size: 10px; }
                        Text { text: r.text; color: Theme.fg; font-size: Theme.small; overflow: elide; }
                    }
                    rta := TouchArea { clicked => { if (r.id == "self") { root.open-notes(); } else { root.open-chat(r.id); } } }
                }
            }
        }

        // ------------------------------------------------ panel: new group
        if root.panel == 5: Rectangle {
            vertical-stretch: 0;
            border-width: 1px;
            border-color: Theme.dim;
            VerticalLayout {
                padding: 6px;
                spacing: 4px;
                Text { text: "> new group"; color: Theme.accent; font-size: Theme.small; }
                gname := RInput { placeholder: "group name"; }
                RCaption { text: "members:"; }
                for p in root.pick-rows: RCheck { text: p.name; checked: p.checked; toggled => { root.pick-toggle(p.id); } }
                HorizontalLayout {
                    spacing: 4px;
                    alignment: start;
                    RButton { text: "create"; clicked => { root.create-group(gname.text); root.panel = 0; } }
                    RButton { text: "close"; tone: Theme.dim; clicked => { root.panel = 0; } }
                }
            }
        }

        // ------------------------------------------------ panel: contact details
        if root.panel == 6: Rectangle {
            vertical-stretch: 0;
            border-width: 1px;
            border-color: Theme.dim;
            VerticalLayout {
                padding: 6px;
                spacing: 4px;
                Text { text: "> contact"; color: Theme.accent; font-size: Theme.small; }
                RInput { text <=> root.d-name; placeholder: "name (only you see it)"; }
                RCaption { text: "fingerprint " + root.d-fp; wrap: word-wrap; font-size: 9px; }
                if root.d-introduced != "": RCaption { text: "introduced by " + root.d-introduced; }
                if root.d-profile != "": Text { text: root.d-profile; color: Theme.fg; font-size: 10px; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 4px;
                    alignment: start;
                    RButton { text: "safety number"; clicked => { root.detail-safety(); } }
                }
                if root.d-safety != "": Text { text: root.d-safety; color: Theme.accent; font-size: 12px; wrap: word-wrap; }
                if root.d-safety != "": RCaption { text: "Compare with your contact (in person or on a call). Same digits = no one in between."; wrap: word-wrap; }
                RCheck { text: "verified"; checked <=> root.d-verified; }
                RCaption { text: "presence:"; }
                HorizontalLayout {
                    spacing: 2px;
                    alignment: start;
                    RTab { text: "normal"; active: root.d-visibility == 0; clicked => { root.d-visibility = 0; } }
                    RTab { text: "always visible"; active: root.d-visibility == 1; clicked => { root.d-visibility = 1; } }
                    RTab { text: "never"; active: root.d-visibility == 2; clicked => { root.d-visibility = 2; } }
                }
                RCheck { text: "ignore (drop their messages)"; checked <=> root.d-ignored; }
                RCheck { text: "urgent messages may break through DND"; checked <=> root.d-urgent; }
                RCheck { text: "tell me when they come online"; checked <=> root.d-notify; }
                RCheck { text: "accept their files automatically"; checked <=> root.d-auto; }
                RCaption { text: "disappearing messages:"; }
                HorizontalLayout {
                    spacing: 2px;
                    alignment: start;
                    RTab { text: "off"; active: root.d-disappearing == 0; clicked => { root.d-disappearing = 0; } }
                    RTab { text: "5m"; active: root.d-disappearing == 1; clicked => { root.d-disappearing = 1; } }
                    RTab { text: "1h"; active: root.d-disappearing == 2; clicked => { root.d-disappearing = 2; } }
                    RTab { text: "1d"; active: root.d-disappearing == 3; clicked => { root.d-disappearing = 3; } }
                    RTab { text: "7d"; active: root.d-disappearing == 4; clicked => { root.d-disappearing = 4; } }
                }
                RInput { text <=> root.d-folder; placeholder: "folder (e.g. work)"; }
                if root.d-devices != "": RCaption { text: "devices: " + root.d-devices; wrap: word-wrap; }
                if root.pick-rows.length > 0: RCaption { text: "introduce them to:"; }
                for p in root.pick-rows: RMenuItem { text: "→ " + p.name; clicked => { root.detail-introduce(p.id); } }
                HorizontalLayout {
                    spacing: 4px;
                    alignment: start;
                    RButton { text: "save"; clicked => { root.detail-save(); root.panel = 0; } }
                    RButton { text: "remove"; tone: Theme.red; clicked => { root.remove-contact(root.d-id); root.panel = 0; } }
                    RButton { text: "close"; tone: Theme.dim; clicked => { root.panel = 0; } }
                }
            }
        }

        // ------------------------------------------------ panel: group details
        if root.panel == 7: Rectangle {
            vertical-stretch: 0;
            border-width: 1px;
            border-color: Theme.dim;
            VerticalLayout {
                padding: 6px;
                spacing: 4px;
                Text { text: "> group"; color: Theme.accent; font-size: Theme.small; }
                if root.g-admin: HorizontalLayout {
                    spacing: 4px;
                    RInput { text <=> root.g-name; }
                    RButton { text: "rename"; clicked => { root.group-rename(); } }
                }
                if !root.g-admin: Text { text: root.g-name; color: Theme.fg; font-weight: 700; }
                RCaption { text: "members:"; }
                for m in root.g-members: HorizontalLayout {
                    spacing: 4px;
                    Text { text: m.name + (m.admin ? " (admin)" : ""); color: Theme.fg; font-size: Theme.small; vertical-alignment: center; horizontal-stretch: 1; }
                    if root.g-admin && !m.admin: RButton { text: "remove"; tone: Theme.red; clicked => { root.group-remove(m.account); } }
                }
                if root.g-admin && root.pick-rows.length > 0: RCaption { text: "add:"; }
                for p in root.pick-rows: RMenuItem { text: "+ " + p.name; clicked => { root.group-add(p.id); } }
                HorizontalLayout {
                    spacing: 4px;
                    alignment: start;
                    RButton { text: "open chat"; clicked => { root.open-group(root.g-id); root.panel = 0; } }
                    RButton { text: "leave"; tone: Theme.red; clicked => { root.group-leave(); root.panel = 0; } }
                    RButton { text: "close"; tone: Theme.dim; clicked => { root.panel = 0; } }
                }
            }
        }

        // ------------------------------------------------ panel: settings
        if root.panel == 3: Rectangle {
            vertical-stretch: 0;
            border-width: 1px;
            border-color: Theme.dim;
            VerticalLayout {
                padding: 6px;
                spacing: 4px;
                HorizontalLayout {
                    spacing: 1px;
                    alignment: start;
                    RTab { text: "general"; active: root.settings-tab == 0; clicked => { root.settings-tab = 0; } }
                    RTab { text: "alerts"; active: root.settings-tab == 6; clicked => { root.settings-tab = 6; } }
                    RTab { text: "keys"; active: root.settings-tab == 7; clicked => { root.settings-tab = 7; } }
                    RTab { text: "lists"; active: root.settings-tab == 8; clicked => { root.settings-tab = 8; } }
                    RTab { text: "me"; active: root.settings-tab == 4; clicked => { root.settings-tab = 4; } }
                }
                HorizontalLayout {
                    spacing: 1px;
                    alignment: start;
                    RTab { text: "net"; active: root.settings-tab == 1; clicked => { root.settings-tab = 1; } }
                    RTab { text: "devices"; active: root.settings-tab == 2; clicked => { root.settings-tab = 2; } }
                    RTab { text: "backup"; active: root.settings-tab == 3; clicked => { root.settings-tab = 3; } }
                    RTab { text: "plugins"; active: root.settings-tab == 5; clicked => { root.settings-tab = 5; } }
                }

                ScrollView {
                    height: 360px;
                    VerticalLayout {
                    alignment: start;
                    padding-right: 10px;
                    spacing: 3px;

                if root.settings-tab == 5: VerticalLayout {
                    alignment: start;
                    spacing: 4px;
                    RCaption { text: "Plugins run as separate programs, only while enabled, with only the permissions listed."; wrap: word-wrap; }
                    if root.plugin-confirm != "": Rectangle {
                        border-width: 1px;
                        border-color: Theme.accent;
                        VerticalLayout {
                            padding: 6px;
                            spacing: 4px;
                            Text { text: root.plugin-confirm-text; color: Theme.fg; font-size: Theme.small; wrap: word-wrap; }
                            HorizontalLayout {
                                spacing: 4px;
                                alignment: start;
                                RButton { text: "enable"; clicked => { root.plugin-enable(root.plugin-confirm); } }
                                RButton { text: "cancel"; tone: Theme.dim; clicked => { root.plugin-cancel(); } }
                            }
                        }
                    }
                    for pl in root.plugins: VerticalLayout {
                        HorizontalLayout {
                            spacing: 3px;
                            RCheck { text: pl.name + (pl.installed ? "" : " (not installed)"); checked: pl.enabled; toggled(v) => { root.plugin-toggle(pl.id, v); } }
                            if pl.enabled && !pl.first: RButton { text: "^"; clicked => { root.plugin-move(pl.id, -1); } }
                            if pl.enabled && !pl.last: RButton { text: "v"; clicked => { root.plugin-move(pl.id, 1); } }
                        }
                        Text { text: pl.description; color: Theme.fg; font-size: 10px; wrap: word-wrap; }
                        Text { text: "may: " + pl.caps; color: Theme.dim; font-size: 9px; wrap: word-wrap; }
                        if pl.usage != "": Text { text: pl.usage; color: Theme.dim; font-size: 9px; }
                    }
                    RCaption { text: "Which plugins are on, their order and folding are shared with your other devices."; wrap: word-wrap; }
                }

                if root.settings-tab == 0: VerticalLayout {
                    alignment: start;
                    spacing: 3px;
                    RCaption { text: "theme"; }
                    HorizontalLayout {
                        spacing: 2px;
                        alignment: start;
                        for t in root.theme-names: RTab { text: t; active: t == root.theme-name; clicked => { root.set-theme(t); } }
                    }
                    RCaption { text: "away message (shown when Away / N/A)"; }
                    RInput { text <=> root.away-msg; placeholder: "e.g. back at 14:00"; }
                    RCheck { text: "auto-reply once per hour while away"; checked <=> root.s-auto-reply; toggled => { root.setting-toggled("auto-reply"); } }
                    RCheck { text: "hide offline contacts"; checked <=> root.s-hide-offline; toggled => { root.setting-toggled("hide-offline"); } }
                    RCheck { text: "open chats on new messages"; checked <=> root.s-popups; toggled => { root.setting-toggled("popups"); } }
                    RCheck { text: "start with the computer"; checked <=> root.s-autostart; toggled => { root.setting-toggled("autostart"); } }
                    RCheck { text: "start hidden (tray only)"; checked <=> root.s-start-min; toggled => { root.setting-toggled("start-min"); } }
                    RCheck { text: "check for updates (GitHub)"; checked <=> root.s-update-check; toggled => { root.setting-toggled("update-check"); } }
                    RCheck { text: "install updates automatically"; checked <=> root.s-update-auto; toggled => { root.setting-toggled("update-auto"); } }
                    HorizontalLayout {
                        spacing: 4px;
                        RButton { text: "check now"; clicked => { root.update-check-now(); } }
                        RCaption { text: root.update-status; vertical-alignment: center; wrap: word-wrap; }
                    }
                    RCheck { text: "auto-hide the bar"; checked <=> root.s-autohide; toggled => { root.setting-toggled("autohide"); } }
                    HorizontalLayout {
                        spacing: 4px;
                        RCaption { text: "bar width (px, or drag its inner edge)"; vertical-alignment: center; }
                        RInput { text <=> root.s-bar-width; width: 50px; }
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        RCaption { text: "away after"; vertical-alignment: center; }
                        RInput { text <=> root.s-auto-away; width: 36px; }
                        RCaption { text: "min, N/A after"; vertical-alignment: center; }
                        RInput { text <=> root.s-auto-na; width: 36px; }
                    }
                    RCaption { text: "Locking the screen sets Away too."; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: 4px;
                        RCaption { text: "lock after idle (min, 0=off)"; vertical-alignment: center; }
                        RInput { text <=> root.s-lock-idle; width: 36px; }
                    }
                    RButton { text: "save"; clicked => { root.save-general(); } }
                }

                if root.settings-tab == 6: VerticalLayout {
                    alignment: start;
                    spacing: 3px;
                    RCheck { text: "send read receipts"; checked <=> root.s-read-receipts; toggled => { root.setting-toggled("read-receipts"); } }
                    RCheck { text: "show others when I am typing"; checked <=> root.s-typing; toggled => { root.setting-toggled("typing"); } }
                    RCheck { text: "desktop notifications"; checked <=> root.s-notify; toggled => { root.setting-toggled("notify"); } }
                    RCheck { text: "notify when contacts come online"; checked <=> root.s-notify-online; toggled => { root.setting-toggled("notify-online"); } }
                    RCaption { text: "(per contact: right-click → tell me when they come online)"; wrap: word-wrap; }
                    RCheck { text: "sounds"; checked <=> root.s-sounds; toggled => { root.setting-toggled("sounds"); } }
                    if root.s-sounds: VerticalLayout {
                        padding-left: 8px;
                        spacing: 2px;
                        for r[i] in root.sound-rows: HorizontalLayout {
                            spacing: 2px;
                            RCheck { text: r.label; checked: r.on; width: 84px; toggled(v) => { root.sound-toggle(i, v); } }
                            Text { text: r.source; color: Theme.dim; font-size: 10px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                            RButton { text: "<"; tip: "previous built-in sound"; clicked => { root.sound-cycle(i, -1); } }
                            RButton { text: ">"; tip: "next built-in sound"; clicked => { root.sound-cycle(i, 1); } }
                            RButton { text: "…"; tip: "use your own sound file"; clicked => { root.sound-pick(i); } }
                            RButton { text: "▸"; tip: "listen"; clicked => { root.sound-play(i); } }
                        }
                        RCaption { text: "< > built-in sounds · … your own file (wav, mp3, ogg, flac; up to 2 MB) · ▸ listen"; wrap: word-wrap; }
                    }
                    RCaption { text: "Occupied and DND silence everything except urgent messages."; wrap: word-wrap; }
                }

                if root.settings-tab == 7: VerticalLayout {
                    alignment: start;
                    spacing: 3px;
                    RCaption { text: "global hotkeys, e.g. Ctrl+Alt+R (empty = off)"; wrap: word-wrap; }
                    HorizontalLayout { spacing: 4px; RCaption { text: "show / hide bar"; width: 110px; vertical-alignment: center; } RInput { text <=> root.s-hk-toggle; } }
                    HorizontalLayout { spacing: 4px; RCaption { text: "reply to last"; width: 110px; vertical-alignment: center; } RInput { text <=> root.s-hk-reply; } }
                    HorizontalLayout { spacing: 4px; RCaption { text: "note to self"; width: 110px; vertical-alignment: center; } RInput { text <=> root.s-hk-notes; } }
                    HorizontalLayout { spacing: 4px; RCaption { text: "away on/off"; width: 110px; vertical-alignment: center; } RInput { text <=> root.s-hk-away; } }
                    HorizontalLayout { spacing: 4px; RCaption { text: "DND on/off"; width: 110px; vertical-alignment: center; } RInput { text <=> root.s-hk-dnd; } }
                    RButton { text: "save keys"; clicked => { root.save-hotkeys(); } }
                    RCaption { text: root.hotkeys-info; wrap: word-wrap; }
                }

                if root.settings-tab == 8: VerticalLayout {
                    alignment: start;
                    spacing: 3px;
                    RCaption { text: "folders (top to bottom as in the list)"; }
                    for f in root.folders: HorizontalLayout {
                        spacing: 3px;
                        if root.folder-edit != f: Text { text: f; color: Theme.fg; font-size: Theme.small; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                        if root.folder-edit == f: RInput { text <=> root.folder-edit-text; accepted(t) => { root.folder-rename(f, t); } }
                        if root.folder-edit != f: RButton { text: "ren"; clicked => { root.folder-edit-text = f; root.folder-edit = f; } }
                        if root.folder-edit == f: RButton { text: "ok"; clicked => { root.folder-rename(f, root.folder-edit-text); } }
                        RButton { text: "^"; clicked => { root.folder-move(f, -1); } }
                        RButton { text: "v"; clicked => { root.folder-move(f, 1); } }
                        RButton { text: "x"; tone: Theme.red; clicked => { root.folder-delete(f); } }
                    }
                    if root.folders.length == 0: RCaption { text: "none yet: right-click a contact and type a folder name."; wrap: word-wrap; }
                    RCaption { text: "visible list: always see you online, even when you are Invisible"; wrap: word-wrap; }
                    for r in root.list-rows: HorizontalLayout {
                        visible: r.kind == "visible";
                        height: r.kind == "visible" ? 22px : 0px;
                        spacing: 3px;
                        Text { text: "  " + r.name; color: Theme.fg; font-size: Theme.small; vertical-alignment: center; horizontal-stretch: 1; }
                        RButton { text: "x"; clicked => { root.list-clear(r.kind, r.id); } }
                    }
                    RCaption { text: "invisible list: never see you online"; wrap: word-wrap; }
                    for r in root.list-rows: HorizontalLayout {
                        visible: r.kind == "invisible";
                        height: r.kind == "invisible" ? 22px : 0px;
                        spacing: 3px;
                        Text { text: "  " + r.name; color: Theme.fg; font-size: Theme.small; vertical-alignment: center; horizontal-stretch: 1; }
                        RButton { text: "x"; clicked => { root.list-clear(r.kind, r.id); } }
                    }
                    RCaption { text: "ignore list: their messages are dropped"; wrap: word-wrap; }
                    for r in root.list-rows: HorizontalLayout {
                        visible: r.kind == "ignored";
                        height: r.kind == "ignored" ? 22px : 0px;
                        spacing: 3px;
                        Text { text: "  " + r.name; color: Theme.fg; font-size: Theme.small; vertical-alignment: center; horizontal-stretch: 1; }
                        RButton { text: "x"; clicked => { root.list-clear(r.kind, r.id); } }
                    }
                    RCaption { text: "Add people to a list: right-click them in the contact list."; wrap: word-wrap; }
                }

                if root.settings-tab == 1: VerticalLayout {
                    alignment: start;
                    spacing: 3px;
                    RCheck { text: "LAN only (no Nostr, no internet peers)"; checked <=> root.s-lan-only; toggled => { root.setting-toggled("lan-only"); } }
                    RCheck { text: "help the network (relay & hold mail for others)"; checked <=> root.s-helper; toggled => { root.setting-toggled("helper"); } }
                    RCheck { text: "connect through routers (public libp2p helpers)"; checked <=> root.s-public-helpers; toggled => { root.setting-toggled("public-helpers"); } }
                    RCaption { text: "Public IPFS/libp2p nodes tell RIM its outside address and help both sides punch through their routers. They see your IP address (like Nostr relays), never content."; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: 4px;
                        RCaption { text: "helper limit kbit/s (0 = none)"; vertical-alignment: center; }
                        RInput { text <=> root.s-bandwidth; width: 60px; }
                    }
                    RCaption { text: "Nostr relays (one per line)"; }
                    RArea { text <=> root.s-relays; height: 60px; }
                    RCaption { text: "bootstrap / relay nodes (multiaddrs)"; }
                    RArea { text <=> root.s-bootstrap; height: 40px; placeholder: "/ip4/…/tcp/…/p2p/12D3…"; }
                    RButton { text: "save"; clicked => { root.save-network(); } }
                    RCaption { text: "diagnostics"; }
                    RArea { text: root.net-info; height: 150px; read-only: true; font-size: 9px; }
                }

                if root.settings-tab == 2: VerticalLayout {
                    alignment: start;
                    spacing: 3px;
                    for d in root.devices: VerticalLayout {
                        HorizontalLayout {
                            spacing: 6px;
                            OsIcon { os: d.os; device: d.device; tint: d.tint; badge: ""; }
                            VerticalLayout {
                                Text { text: d.name + (d.this ? " (this)" : ""); color: Theme.fg; font-size: Theme.small; overflow: elide; }
                                Text { text: d.status + (d.manager ? " · manager" : ""); color: Theme.dim; font-size: 10px; }
                                if d.info != "": Text { text: d.info; color: Theme.dim; font-size: 9px; overflow: elide; }
                            }
                        }
                        if !d.this: HorizontalLayout {
                            spacing: 3px;
                            alignment: start;
                            RButton { text: "lock"; clicked => { root.device-lock(d.peer); } }
                            if root.is-manager: RButton { text: "remove"; tone: Theme.red; clicked => { root.device-remove(d.peer, false); } }
                            if root.is-manager: RButton { text: "remove+wipe"; tone: Theme.red; clicked => { root.device-remove(d.peer, true); } }
                        }
                    }
                    if root.is-manager: VerticalLayout {
                        spacing: 3px;
                        RCaption { text: "link a device: paste the code it shows"; }
                        RArea { text <=> root.link-input; height: 44px; font-size: 9px; }
                        RButton { text: "check code"; clicked => { root.link-changed(); } }
                        if root.link-check-words != "": RCaption { text: "it must show: " + root.link-check-words; wrap: word-wrap; color: Theme.accent; }
                        lm := RCheck { text: "make it a manager (can link & remove)"; }
                        lh := RCheck { text: "copy chat history"; checked: true; }
                        if lh.checked: HorizontalLayout {
                            spacing: 4px;
                            RCaption { text: "last N days (empty = all)"; vertical-alignment: center; }
                            RInput { text <=> root.s-link-days; width: 50px; }
                        }
                        RButton { text: "words match — link"; enabled: root.link-check-words != ""; clicked => { root.link-device(lm.checked, lh.checked, root.s-link-days); } }
                    }
                    if !root.is-manager: RCaption { text: "Only manager devices can link or remove devices."; wrap: word-wrap; }
                }

                if root.settings-tab == 3: VerticalLayout {
                    alignment: start;
                    spacing: 3px;
                    RButton { text: "back up now…"; clicked => { root.backup-now(); } }
                    RCaption { text: "automatic backups to folder"; }
                    HorizontalLayout {
                        spacing: 4px;
                        RInput { text <=> root.s-backup-dir; placeholder: "folder (NAS, cloud folder…)"; }
                        RButton { text: "…"; clicked => { root.browse-backup-dir(); } }
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        RCaption { text: "every (h)"; vertical-alignment: center; }
                        RInput { text <=> root.s-backup-hours; width: 40px; }
                        RCaption { text: "keep"; vertical-alignment: center; }
                        RInput { text <=> root.s-backup-keep; width: 40px; }
                    }
                    RButton { text: "save schedule"; clicked => { root.save-backup(); } }
                    RButton { text: "import history from backup…"; clicked => { root.import-history(); } }
                    RButton { text: "new recovery key"; clicked => { root.new-recovery-key(); } }
                    RCaption { text: "Backups are encrypted with your passphrase and your recovery key. Keep one somewhere safe: without a backup or another manager device, a lost account cannot be recovered."; wrap: word-wrap; }
                }

                if root.settings-tab == 4: VerticalLayout {
                    alignment: start;
                    spacing: 3px;
                    RCaption { text: "nickname (a suggestion; your contacts pick their own name for you)"; wrap: word-wrap; }
                    RInput { text <=> root.s-nick; placeholder: "nickname"; }
                    RCaption { text: "profile (only authorized contacts see it)"; }
                    RInput { text <=> root.s-about; placeholder: "about"; }
                    RInput { text <=> root.s-location; placeholder: "location"; }
                    RInput { text <=> root.s-homepage; placeholder: "homepage"; }
                    RInput { text <=> root.s-interests; placeholder: "interests"; }
                    RButton { text: "save"; clicked => { root.save-profile(); } }
                    RCaption { text: "fingerprint " + root.my-fp; wrap: word-wrap; font-size: 9px; }
                    RButton { text: "wipe this account from this computer"; tone: Theme.red; clicked => { wipe-confirm.show(); } }
                }
                    }
                }
                RButton { text: "close"; tone: Theme.dim; clicked => { root.panel = 0; } }
            }
            wipe-confirm := PopupWindow {
                x: 10px;
                y: 40px;
                width: parent.width - 20px;
                close-policy: close-on-click-outside;
                Rectangle {
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: Theme.red;
                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;
                        Text { text: "Erase keys, contacts and history from this computer? This cannot be undone. Make sure you have a backup or another device."; color: Theme.fg; wrap: word-wrap; font-size: Theme.small; }
                        RButton { text: "yes, wipe"; tone: Theme.red; clicked => { root.wipe-account(); } }
                    }
                }
            }
        }

        // ------------------------------------------------ authorization requests
        for p in root.pending: Rectangle {
            vertical-stretch: 0;
            border-width: 1px;
            border-color: p.warning != "" ? Theme.red : Theme.accent;
            VerticalLayout {
                padding: 6px;
                spacing: 3px;
                Text { text: "auth request: " + p.nick; color: Theme.accent; font-weight: 700; }
                if p.introduced-by != "": Text { text: "introduced by " + p.introduced-by; color: Theme.dim; font-size: 10px; }
                if p.warning != "": Text { text: p.warning; color: Theme.red; font-size: 10px; wrap: word-wrap; }
                Text { text: "\"" + p.text + "\""; color: Theme.fg; wrap: word-wrap; font-size: Theme.small; }
                Text { text: p.fp; color: Theme.dim; font-size: 9px; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 4px;
                    alignment: start;
                    RButton { text: "accept"; clicked => { root.accept(p.id); } }
                    RButton { text: "deny"; tone: Theme.red; clicked => { root.deny(p.id); } }
                }
            }
        }

        // ------------------------------------------------ split region: list + docked chat
        region := Rectangle {
            vertical-stretch: 1;
            property <length> gap: 6px;
            property <length> top-h: root.chat-docked
                ? max(60px, min(self.height - gap - 80px, (self.height - gap) * root.split))
                : self.height;

            Rectangle {
                x: 0; y: 0;
                width: parent.width;
                height: parent.top-h;
                border-width: 1px;
                border-color: Theme.line;
                background: Theme.panel;
                if root.contacts.length == 0: Text {
                    x: 8px; y: 8px; width: parent.width - 16px;
                    text: "No contacts yet.\n\n[@] makes an invite to send to a friend; [+] adds theirs.";
                    color: Theme.dim; wrap: word-wrap; font-size: Theme.small;
                }
                ListView {
                    for c in root.contacts: Rectangle {
                        height: c.kind == "folder" ? 18px : 38px;
                        background: c.kind != "folder" && root.chat-docked && c.id == root.dchat-id ? Theme.line : (row-ta.has-hover ? Theme.hover : transparent);
                        if c.kind == "folder": HorizontalLayout {
                            padding-left: 6px;
                            Text { text: (c.collapsed ? "▸ " : "▾ ") + c.name + "  (" + c.count + ")"; color: Theme.dim; font-size: 10px; vertical-alignment: center; }
                        }
                        if c.kind != "folder": HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 8px;
                            OsIcon { os: c.os; device: c.device; tint: c.tint; badge: c.badge; y: 5px; }
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: c.name + (c.verified ? " ✓" : "") + (c.bot ? " [bot]" : "") + (c.unread > 0 ? "  (" + c.unread + ")" : "");
                                    color: c.unread > 0 ? Theme.accent : (c.status == "Offline" ? Theme.dim : Theme.fg);
                                    font-weight: c.unread > 0 ? 700 : 400;
                                    overflow: elide;
                                }
                                Text {
                                    text: c.typing ? "typing…" : c.awaiting ? "awaiting authorization" : row-ta.has-hover && c.devs != "" ? c.devs : c.music != "" && c.status != "Offline" ? "♪ " + c.music : (c.status + (c.battery ? " · on battery" : "") + (c.away != "" ? " · " + c.away : ""));
                                    color: c.awaiting || c.typing ? Theme.accent : Theme.dim;
                                    font-size: Theme.small;
                                    overflow: elide;
                                }
                            }
                        }
                        row-ta := TouchArea {
                            changed has-hover => {
                                if (self.has-hover) {
                                    Tip.x = self.absolute-position.x + 40px;
                                    Tip.top = self.absolute-position.y;
                                    Tip.bottom = self.absolute-position.y + self.height;
                                    Tip.text = c.kind == "contact" ? "double-click: chat · right-click: details, lists, folder" : c.kind == "group" ? "double-click: group chat · right-click: members" : c.kind == "notes" ? "notes to yourself, on all your devices" : "click: fold / unfold";
                                } else {
                                    Tip.text = "";
                                }
                            }
                            clicked => {
                                if (c.kind == "folder") { root.toggle-folder(c.name); }
                                else if (c.kind == "contact") { root.select-contact(c.id); }
                            }
                            double-clicked => {
                                if (c.kind == "contact") { root.open-chat(c.id); }
                                else if (c.kind == "notes") { root.open-notes(); }
                                else if (c.kind == "group") { root.open-group(c.id); }
                            }
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                                    if (c.kind == "contact") { root.show-details(c.id); }
                                    else if (c.kind == "group") { root.show-group(c.id); }
                                }
                            }
                        }
                    }
                }
            }

            if root.chat-docked: Rectangle {
                x: 0;
                y: parent.top-h;
                width: parent.width;
                height: parent.gap;
                Rectangle {
                    y: (parent.height - 2px) / 2;
                    height: 2px;
                    width: 32px;
                    x: (parent.width - 32px) / 2;
                    background: split-ta.has-hover || split-ta.pressed ? Theme.accent : Theme.line;
                }
                split-ta := TouchArea {
                    mouse-cursor: ns-resize;
                    moved => {
                        if (self.pressed) {
                            root.split = max(0.1, min(0.9, root.split + (self.mouse-y - self.pressed-y) / (region.height - region.gap)));
                        }
                    }
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.up) {
                            root.split-changed(root.split);
                        }
                    }
                }
            }

            if root.chat-docked: ChatPane {
                x: 0;
                y: parent.top-h + parent.gap;
                width: parent.width;
                height: parent.height - parent.top-h - parent.gap;
                border-width: 1px;
                border-color: Theme.line;
                mode: root.dchat-mode;
                name: root.dchat-name;
                status: root.dchat-status;
                tint: root.dchat-tint;
                os: root.dchat-os;
                device: root.dchat-device;
                badge: root.dchat-badge;
                away: root.dchat-away;
                info: root.dchat-info;
                typing: root.dchat-typing;
                authorized: root.dchat-authorized;
                lines: root.dchat-lines;
                can-task: root.can-task;
                send(t, u, r) => { root.dchat-send(t, u, r); }
                typed => { root.dchat-typed(); }
                line-action(a, i) => { root.dchat-line-action(a, i); }
                edit-commit(i, t) => { root.dchat-edit(i, t); }
                file-send => { root.dchat-file-send(); }
                file-action(a, i) => { root.dchat-file-action(a, i); }
                if root.dchat-mode == "contact": RButton { text: root.dchat-call-state == "" ? "call" : "hang up"; height: 18px; tone: root.dchat-call-state == "" ? Theme.fg : Theme.red; tip: root.dchat-call-state == "" ? "voice call (needs a direct connection; headphones recommended)" : "end the call"; clicked => { root.dchat-call-toggle(); } }
                TButton { glyph: "^"; tip: "open in its own window"; clicked => { root.dchat-undock(); } }
                TButton { glyph: "x"; danger: true; tip: "close this chat"; clicked => { root.dchat-close(); } }
            }
        }

        // plugin sections (fixed size, outside the split region)
        for g in root.gadgets: Rectangle {
            vertical-stretch: 0;
            border-width: 1px;
            border-color: Theme.line;
            background: Theme.panel;
            VerticalLayout {
                padding: 4px;
                spacing: 3px;
                Rectangle {
                    height: 14px;
                    Text { x: 0; width: parent.width; text: (g.collapsed ? "▸ " : "▾ ") + g.name; color: Theme.dim; font-size: 10px; vertical-alignment: center; horizontal-alignment: left; }
                    TouchArea { mouse-cursor: pointer; clicked => { root.gadget-collapse(g.id); } }
                }
                if !g.collapsed: VerticalLayout {
                    spacing: 3px;
                    for row in g.rows: HorizontalLayout {
                        spacing: 4px;
                        for it in row.items: GadgetItemView {
                            item: it;
                            click => { root.gadget-click(g.id, it.id); }
                            input(v) => { root.gadget-input(g.id, it.id, v); }
                            check(v) => { root.gadget-check(g.id, it.id, v); }
                        }
                    }
                }
            }
        }

        // call banner
        if root.call-state != "": Rectangle {
            vertical-stretch: 0;
            border-width: 1px;
            border-color: root.call-state == "ringing" ? Theme.red : Theme.accent;
            background: root.call-state == "ringing" ? Theme.hover : transparent;
            VerticalLayout {
                padding: 4px;
                spacing: 3px;
                Text { text: root.call-text; color: Theme.accent; font-size: Theme.small; font-weight: 700; wrap: word-wrap; }
                if root.call-screen-out: Text { text: "you are sharing your screen"; color: Theme.red; font-size: Theme.small; font-weight: 700; }
                HorizontalLayout {
                    spacing: 4px;
                    alignment: start;
                    if root.call-state == "ringing": RButton { text: "accept"; tip: "answer the call"; clicked => { root.call-accept(); } }
                    if root.call-state == "ringing": RButton { text: "decline"; tone: Theme.red; clicked => { root.call-decline(); } }
                    if root.call-state == "active": RButton { text: root.call-muted ? "unmute" : "mute"; tip: "microphone on / off"; clicked => { root.call-mute(); } }
                    if root.call-state == "active" || root.call-state == "calling": RButton { text: "hang up"; tone: Theme.red; clicked => { root.call-hangup(); } }
                }
                if root.call-state == "active": HorizontalLayout {
                    spacing: 4px;
                    alignment: start;
                    RButton { text: root.call-screen-out ? "stop sharing" : "share screen"; tone: root.call-screen-out ? Theme.red : Theme.fg; tip: root.call-screen-out ? "stop showing your screen" : "show your screen (view only; needs a direct connection)"; clicked => { root.call-share(); } }
                    if root.call-monitors > 1: HorizontalLayout {
                        spacing: 1px;
                        for i in root.call-monitors: RTab { text: i + 1; width: 24px; active: i == root.call-monitor; clicked => { root.call-monitor-pick(i); } }
                    }
                    if root.call-state == "active" && root.call-screen-in && !root.call-viewer-open: RButton { text: "view screen"; clicked => { root.call-view(); } }
                }
            }
        }

        // update banner
        if root.update-state != "": Rectangle {
            vertical-stretch: 0;
            border-width: 1px;
            border-color: Theme.accent;
            HorizontalLayout {
                padding: 4px;
                spacing: 4px;
                Text { text: root.update-text; color: Theme.accent; font-size: Theme.small; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
                if root.update-state == "available": RButton { text: "install"; tip: "download, check the signature, install; then restart"; clicked => { root.update-install(); } }
                if root.update-state == "available": RButton { text: "later"; tone: Theme.dim; clicked => { root.update-later(); } }
                if root.update-state == "ready": RButton { text: "restart"; tip: "restart RogueIM to use the new version"; clicked => { root.update-restart(); } }
            }
        }

        // footer
        Text { text: root.notice; color: Theme.accent; font-size: Theme.small; wrap: word-wrap; visible: root.notice != ""; vertical-stretch: 0; }
        Text { text: "fp " + root.my-fp; color: Theme.faint; font-size: 9px; wrap: word-wrap; vertical-stretch: 0; }
    }

    // ---------------------------------------------------------------- width handle on the inner edge
    if root.logged-in && !root.collapsed && root.docked: handle := Rectangle {
        property <length> d;
        x: root.dock-left ? root.width - 5px : 0px;
        y: 0px;
        width: 5px;
        height: root.height;
        background: edge.has-hover || edge.pressed ? Theme.accent : transparent;
        edge := TouchArea {
            mouse-cursor: ew-resize;
            moved => {
                if (self.pressed) {
                    handle.d = self.mouse-x - self.pressed-x;
                }
            }
            pointer-event(e) => {
                if (e.kind == PointerEventKind.up) {
                    root.bar-resized(root.dock-left ? handle.d : -handle.d);
                    handle.d = 0px;
                }
            }
            changed has-hover => {
                if (self.has-hover) {
                    Tip.x = root.dock-left ? root.width - 160px : 8px;
                    Tip.top = self.mouse-y;
                    Tip.bottom = self.mouse-y + 12px;
                    Tip.text = "drag to make the bar wider or narrower";
                } else {
                    Tip.text = "";
                }
            }
        }
        if edge.pressed && handle.d != 0px: Rectangle {
            x: root.dock-left ? -70px : 8px;
            y: edge.mouse-y;
            width: 62px;
            height: 18px;
            background: Theme.accent;
            Text {
                text: round((root.width + (root.dock-left ? handle.d : -handle.d)) / 1px) + " px";
                color: Theme.on-accent;
                font-size: Theme.small;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    TipLayer { }
}
