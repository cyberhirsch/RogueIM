import { ListView } from "std-widgets.slint";
import { Theme, RInput, OsIcon, RButton, Tip, TipLayer } from "theme.slint";

export struct ChatLine {
    id: string,
    time: string,
    who: string,
    text: string,
    mine: bool,
    // "", "queued", "stored", "delivered", "read", "failed"
    state: string,
    edited: bool,
    deleted: bool,
    urgent: bool,
    expires: bool,
    reply-text: string,
    file-id: string,
    file-name: string,
    file-size: string,
    file-progress: float,
    // offered, waiting, transferring, paused, done, declined, failed, nodirect
    file-state: string,
    has-image: bool,
    image: image,
}

// Square glyph button for the title bar.
export component TButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> active;
    in property <bool> danger;
    in property <string> tip;
    callback clicked;
    width: 22px;
    height: 20px;
    background: ta.has-hover ? (root.danger ? Theme.red : Theme.hover) : transparent;
    Text {
        text: root.glyph;
        color: ta.has-hover && root.danger ? Theme.on-accent : (root.active ? Theme.accent : Theme.dim);
        font-size: 12px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        clicked => { Tip.text = ""; root.clicked(); }
        changed has-hover => {
            if (self.has-hover && root.tip != "") {
                Tip.x = root.absolute-position.x;
                Tip.top = root.absolute-position.y;
                Tip.bottom = root.absolute-position.y + root.height;
                Tip.text = root.tip;
            } else if (!self.has-hover && Tip.text == root.tip) {
                Tip.text = "";
            }
        }
    }
}

component LinkText inherits Text {
    callback clicked;
    color: ta.has-hover ? Theme.accent : Theme.dim;
    font-size: 10px;
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Chat content: slim header bar (also the drag handle), log, input.
// Title-bar buttons are passed in as children and placed at the right of the header.
export component ChatPane inherits Rectangle {
    // "contact", "group" or "notes"
    in property <string> mode: "contact";
    in property <string> name;
    in property <string> fp;
    in property <string> status;
    in property <color> tint;
    in property <string> os;
    in property <string> device;
    in property <string> badge;
    in property <string> away;
    in property <string> info;
    in property <bool> authorized: true;
    in property <bool> typing;
    in property <[ChatLine]> lines;
    in property <bool> can-task;
    in-out property <string> reply-id;
    in-out property <string> reply-text;
    in-out property <bool> urgent;
    callback send(string, bool, string);
    callback typed();
    callback line-action(string, string);
    callback edit-commit(string, string);
    callback file-send();
    callback file-action(string, string);
    callback drag(length, length);
    callback header-double-clicked();
    // Ctrl+V: true if the clipboard held a picture (then it was sent)
    callback paste-image(string) -> bool;

    property <string> selected-id;
    property <string> editing-id;
    property <bool> scroll-pending;
    changed lines => { root.scroll-pending = true; }
    // The model stays the same while rows are added, so watch the row count too.
    property <int> line-count: root.lines.length;
    changed line-count => { root.scroll-pending = true; }
    Timer {
        interval: 40ms;
        running: root.scroll-pending;
        triggered => {
            list.content-y = min(0px, list.visible-height - list.content-height);
            root.scroll-pending = false;
        }
    }

    background: Theme.bg;

    VerticalLayout {
        // header = title bar
        Rectangle {
            height: 30px;
            background: Theme.panel;
            head-ta := TouchArea {
                moved => {
                    if (self.pressed) {
                        root.drag(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                    }
                }
                double-clicked => { root.header-double-clicked(); }
            }
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 4px;
                spacing: 6px;
                alignment: stretch;
                OsIcon { os: root.os; device: root.device; tint: root.tint; badge: root.badge; y: 1px; }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text { text: root.name; color: Theme.fg; font-weight: 700; overflow: elide; }
                    Text {
                        text: root.typing ? "typing…" : (root.status + (root.away != "" ? " · " + root.away : "") + (root.info != "" ? " · " + root.info : ""));
                        color: root.typing ? Theme.accent : root.tint;
                        font-size: 10px;
                        overflow: elide;
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 1px;
                    padding-top: 5px;
                    padding-bottom: 5px;
                    @children
                }
            }
        }
        Rectangle { height: 1px; background: Theme.line; }

        // log
        Rectangle {
            background: Theme.panel;
            vertical-stretch: 1;
            list := ListView {
                for l in root.lines: Rectangle {
                    background: l.id == root.selected-id ? Theme.hover : transparent;
                    VerticalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        padding-top: 3px;
                        padding-bottom: 2px;
                        spacing: 1px;
                        Rectangle {
                            height: 15px;
                            HorizontalLayout {
                                spacing: 6px;
                                Text { text: l.who; color: l.mine ? Theme.accent : Theme.other; font-weight: 700; font-size: 11px; }
                                Text { text: l.time; color: Theme.faint; font-size: 10px; vertical-alignment: center; }
                                if l.urgent: Text { text: "urgent"; color: Theme.red; font-size: 10px; font-weight: 700; vertical-alignment: center; }
                                if l.edited: Text { text: "edited"; color: Theme.faint; font-size: 10px; vertical-alignment: center; }
                                if l.expires: Text { text: "⌛"; color: Theme.faint; font-size: 10px; vertical-alignment: center; }
                                Rectangle { }
                                if l.state != "": Text {
                                    text: l.state;
                                    color: l.state == "failed" ? Theme.red : (l.state == "read" || l.state == "delivered" ? Theme.accent : Theme.faint);
                                    font-size: 10px;
                                    vertical-alignment: center;
                                }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.selected-id = root.selected-id == l.id ? "" : l.id; }
                            }
                        }
                        if l.reply-text != "": Text {
                            text: "↳ " + l.reply-text;
                            color: Theme.dim;
                            font-size: 10px;
                            overflow: elide;
                        }
                        if l.deleted: Text { text: "(deleted)"; color: Theme.faint; font-size: 11px; font-italic: true; }
                        // pasted picture: inline when there is room, else an icon that opens it
                        if !l.deleted && l.has-image && root.width >= 300px: Image {
                            source: l.image;
                            height: min(240px, (root.width - 24px) * l.image.height / max(1, l.image.width));
                            image-fit: contain;
                            horizontal-alignment: left;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.line-action("image", l.id); }
                            }
                        }
                        if !l.deleted && l.has-image && root.width < 300px: LinkText {
                            text: "[▣ image]";
                            clicked => { root.line-action("image", l.id); }
                        }
                        if !l.deleted && l.file-id == "" && l.id != root.editing-id && (l.text != "" || !l.has-image): TextInput {
                            text: l.text;
                            read-only: true;
                            single-line: false;
                            wrap: word-wrap;
                            color: l.state == "failed" ? Theme.red : (l.state == "queued" ? Theme.dim : Theme.fg);
                            selection-background-color: Theme.accent;
                            selection-foreground-color: Theme.on-accent;
                        }
                        if l.id == root.editing-id: RInput {
                            text: l.text;
                            accepted(t) => {
                                root.edit-commit(l.id, t);
                                root.editing-id = "";
                            }
                        }
                        // file card
                        if l.file-id != "": Rectangle {
                            border-width: 1px;
                            border-color: Theme.line;
                            VerticalLayout {
                                padding: 4px;
                                spacing: 3px;
                                HorizontalLayout {
                                    spacing: 6px;
                                    Text { text: "▤ " + l.file-name; color: Theme.fg; font-size: 11px; overflow: elide; horizontal-stretch: 1; }
                                    Text { text: l.file-size; color: Theme.dim; font-size: 10px; }
                                }
                                if l.file-state == "transferring" || l.file-state == "paused" || l.file-state == "waiting": Rectangle {
                                    height: 4px;
                                    background: Theme.line;
                                    Rectangle { x: 0; width: parent.width * max(0.0, min(1.0, l.file-progress)); background: Theme.accent; }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: l.file-state == "nodirect" ? "no direct connection — same LAN, IPv6 or UPnP help; retrying"
                                            : l.file-state == "offered" && !l.mine ? "offered"
                                            : l.file-state == "offered" ? "waiting for them to accept"
                                            : l.file-state;
                                        color: l.file-state == "failed" || l.file-state == "nodirect" ? Theme.red : Theme.dim;
                                        font-size: 10px;
                                        wrap: word-wrap;
                                        horizontal-stretch: 1;
                                    }
                                    if !l.mine && l.file-state == "offered": LinkText { text: "[accept]"; clicked => { root.file-action("accept", l.file-id); } }
                                    if !l.mine && l.file-state == "offered": LinkText { text: "[decline]"; clicked => { root.file-action("decline", l.file-id); } }
                                    if l.file-state == "transferring": LinkText { text: "[pause]"; clicked => { root.file-action("pause", l.file-id); } }
                                    if l.file-state == "paused": LinkText { text: "[resume]"; clicked => { root.file-action("resume", l.file-id); } }
                                    if l.file-state == "transferring" || l.file-state == "paused" || l.file-state == "waiting" || l.file-state == "nodirect": LinkText { text: "[cancel]"; clicked => { root.file-action("cancel", l.file-id); } }
                                    if !l.mine && l.file-state == "done": LinkText { text: "[open folder]"; clicked => { root.file-action("open", l.file-id); } }
                                }
                            }
                        }
                        // actions for the selected line
                        if l.id == root.selected-id && !l.deleted: HorizontalLayout {
                            spacing: 10px;
                            height: 14px;
                            if root.mode != "notes": LinkText {
                                text: "[reply]";
                                clicked => {
                                    root.reply-id = l.id;
                                    root.reply-text = l.who + ": " + l.text;
                                    root.selected-id = "";
                                    input.focus();
                                }
                            }
                            if l.mine && root.mode == "contact" && l.file-id == "": LinkText {
                                text: "[edit]";
                                clicked => {
                                    root.editing-id = l.id;
                                    root.selected-id = "";
                                }
                            }
                            if root.mode == "contact": LinkText {
                                text: l.mine ? "[delete for everyone]" : "[delete here]";
                                clicked => {
                                    root.line-action("delete", l.id);
                                    root.selected-id = "";
                                }
                            }
                            if root.can-task && root.mode != "notes": LinkText {
                                text: "[task]";
                                clicked => {
                                    root.line-action("task", l.who + "\u{1}" + l.text);
                                    root.selected-id = "";
                                }
                            }
                            LinkText {
                                text: "[copy]";
                                clicked => {
                                    root.line-action("copy", l.text);
                                    root.selected-id = "";
                                }
                            }
                        }
                    }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.line; }

        if root.reply-id != "": Rectangle {
            height: 18px;
            background: Theme.panel;
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 4px;
                Text { text: "↳ " + root.reply-text; color: Theme.dim; font-size: 10px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                TButton { glyph: "x"; height: 18px; tip: "cancel the reply"; clicked => { root.reply-id = ""; root.reply-text = ""; } }
            }
        }

        HorizontalLayout {
            spacing: 0px;
            if root.mode == "contact": TButton {
                glyph: "!";
                tip: "urgent: breaks through Occupied / DND once (max 3 per hour)";
                active: root.urgent;
                height: 24px;
                clicked => { root.urgent = !root.urgent; }
            }
            // Wraps and grows with the text (up to 8 lines). Enter sends;
            // Ctrl+V with a picture in the clipboard sends the picture.
            Rectangle {
                horizontal-stretch: 1;
                height: min(132px, max(24px, input.preferred-height + 8px));
                background: Theme.panel;
                FocusScope {
                    capture-key-pressed(e) => {
                        if (e.text == Key.Return) {
                            if (root.authorized && input.text != "") {
                                root.send(input.text, root.urgent, root.reply-id);
                                input.text = "";
                                root.urgent = false;
                                root.reply-id = "";
                                root.reply-text = "";
                            }
                            return accept;
                        }
                        if ((e.modifiers.control || e.modifiers.meta) && (e.text == "v" || e.text == "V")) {
                            if (root.authorized && root.paste-image(input.text)) {
                                input.text = "";
                                return accept;
                            }
                        }
                        return reject;
                    }
                    input := TextInput {
                        x: 5px;
                        y: 4px;
                        width: parent.width - 10px;
                        height: parent.height - 8px;
                        single-line: false;
                        wrap: word-wrap;
                        color: Theme.fg;
                        font-size: Theme.fs;
                        selection-background-color: Theme.accent;
                        selection-foreground-color: Theme.on-accent;
                        edited => { root.typed(); }
                    }
                }
                if input.text == "": Text {
                    x: 5px;
                    y: 4px;
                    text: root.authorized ? (root.urgent ? "urgent message…" : "message… (Ctrl+V pastes a picture)") : "waiting for authorization…";
                    color: Theme.faint;
                    font-size: Theme.fs;
                }
            }
            if root.mode != "group" && root.mode != "bot": TButton {
                glyph: "+";
                tip: "send a file (direct connection only; you can also drop files here)";
                height: 24px;
                clicked => { root.file-send(); }
            }
        }
    }

    public function focus-input() {
        input.focus();
    }
}

export component ChatWindow inherits Window {
    title: "RogueIM · " + root.name;
    icon: @image-url("../assets/icon.png");
    no-frame: true;
    always-on-top: root.pinned;
    preferred-width: 360px;
    preferred-height: 440px;
    min-width: 240px;
    min-height: 180px;
    background: Theme.line;
    default-font-family: Theme.font;
    default-font-size: Theme.fs;

    in property <string> mode: "contact";
    in property <string> name;
    in property <string> fp;
    in property <string> status;
    in property <color> tint;
    in property <string> os;
    in property <string> device;
    in property <string> badge;
    in property <string> away;
    in property <string> info;
    in property <bool> authorized: true;
    in property <bool> typing;
    in property <[ChatLine]> lines;
    in property <bool> is-max;
    in property <bool> can-task;
    in-out property <bool> pinned;
    // "", "calling", "ringing", "active": the call with this contact
    in property <string> call-state;
    callback call-toggle();

    callback send(string, bool, string);
    callback typed();
    callback line-action(string, string);
    callback edit-commit(string, string);
    callback file-send();
    callback file-action(string, string);
    callback paste-image(string) -> bool;
    callback drag(length, length);
    callback resize(length, length);
    callback minimize();
    callback toggle-maximize();
    callback dock();
    callback close-chat();

    // 1px frame in the line colour
    pane := ChatPane {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        mode: root.mode;
        name: root.name;
        fp: root.fp;
        status: root.status;
        tint: root.tint;
        os: root.os;
        device: root.device;
        badge: root.badge;
        away: root.away;
        info: root.info;
        authorized: root.authorized;
        typing: root.typing;
        lines: root.lines;
        can-task: root.can-task;
        send(t, u, r) => { root.send(t, u, r); }
        typed => { root.typed(); }
        line-action(a, i) => { root.line-action(a, i); }
        edit-commit(i, t) => { root.edit-commit(i, t); }
        file-send => { root.file-send(); }
        file-action(a, i) => { root.file-action(a, i); }
        paste-image(t) => { return root.paste-image(t); }
        drag(dx, dy) => { root.drag(dx, dy); }
        header-double-clicked => { root.toggle-maximize(); }

        if root.mode == "contact": RButton { text: root.call-state == "" ? "call" : "hang up"; height: 18px; tone: root.call-state == "" ? Theme.fg : Theme.red; tip: root.call-state == "" ? "voice call (needs a direct connection; headphones recommended)" : "end the call"; clicked => { root.call-toggle(); } }
        TButton { glyph: "*"; active: root.pinned; tip: root.pinned ? "pinned: stays on top (click to unpin)" : "pin: keep this chat on top"; clicked => { root.pinned = !root.pinned; } }
        TButton { glyph: "v"; tip: "dock into the bar"; clicked => { root.dock(); } }
        TButton { glyph: "_"; tip: "minimize"; clicked => { root.minimize(); } }
        TButton { glyph: root.is-max ? "=" : "[]"; tip: root.is-max ? "restore" : "maximize"; clicked => { root.toggle-maximize(); } }
        TButton { glyph: "x"; danger: true; tip: "close"; clicked => { root.close-chat(); } }
    }

    // resize grip, bottom-right
    Rectangle {
        x: parent.width - 12px;
        y: parent.height - 12px;
        width: 12px;
        height: 12px;
        Text { text: "◢"; color: Theme.faint; font-size: 9px; horizontal-alignment: right; vertical-alignment: bottom; }
        TouchArea {
            mouse-cursor: nwse-resize;
            moved => {
                if (self.pressed) {
                    root.resize(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                }
            }
        }
    }

    init => { pane.focus-input(); }

    TipLayer { }
}

// A pasted picture at full size.
export component ImageWindow inherits Window {
    title: "RogueIM · picture from " + root.who;
    icon: @image-url("../assets/icon.png");
    background: #000000;
    in property <string> who;
    in property <image> picture;
    preferred-width: min(1200px, max(240px, root.picture.width * 1px));
    preferred-height: min(800px, max(160px, root.picture.height * 1px));
    Image {
        width: parent.width;
        height: parent.height;
        source: root.picture;
        image-fit: contain;
    }
}
