// Bundled so the retro monospace look is the same on every OS.
import "../assets/fonts/Hack-Regular.ttf";

// Colour tokens, set from Rust per theme (Graphite default, Grey, Green, Amber).
// Defaults here = Graphite. One monospace face, hard edges, no gradients.

export global Theme {
    in-out property <color> bg: #1e1f22;
    in-out property <color> panel: #2a2c30;
    in-out property <color> line: #3a3d42;
    in-out property <color> fg: #d6d6d6;
    in-out property <color> dim: #8a8f98;
    in-out property <color> faint: #54585f;
    in-out property <color> accent: #e0a040;
    in-out property <color> red: #ff6b6b;
    in-out property <color> hover: #34373c;
    in-out property <color> on-accent: #1e1f22;
    // name colour of the other person in a chat (own name uses accent)
    in-out property <color> other: #6cb6ff;
    out property <string> font: "Hack";
    out property <length> fs: 13px;
    out property <length> small: 11px;
}

// Tooltip shared by one window: a hovered element puts its text and position
// here, TipLayer draws it after a short delay.
export global Tip {
    in-out property <string> text;
    in-out property <length> x;
    in-out property <length> top;
    in-out property <length> bottom;
}

// Put this last in a window. It never takes mouse input.
export component TipLayer inherits Rectangle {
    property <string> cur: Tip.text;
    property <bool> shown;
    changed cur => { root.shown = false; }
    Timer {
        interval: 550ms;
        running: root.cur != "" && !root.shown;
        triggered => { root.shown = true; }
    }
    if root.shown && root.cur != "": Rectangle {
        property <length> w: min(root.width - 8px, min(230px, label.preferred-width + 10px));
        property <length> h: label.preferred-height + 6px;
        width: self.w;
        height: self.h;
        x: max(4px, min(Tip.x, root.width - self.w - 4px));
        y: Tip.bottom + 2px + self.h > root.height ? max(0px, Tip.top - self.h - 2px) : Tip.bottom + 2px;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.fg;
        label := Text {
            x: 5px;
            y: 3px;
            width: parent.w - 10px;
            text: root.cur;
            color: Theme.fg;
            font-size: Theme.small;
            wrap: word-wrap;
        }
    }
}

// Bracketed text button: [ Add ]
export component RButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <color> tone: Theme.fg;
    in property <string> tip;
    callback clicked;
    height: 22px;
    border-width: 1px;
    border-color: !root.enabled ? Theme.faint : ta.has-hover ? root.tone : Theme.dim;
    background: ta.pressed ? Theme.hover : transparent;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        padding-top: 2px;
        padding-bottom: 2px;
        Text {
            text: root.text;
            color: root.enabled ? root.tone : Theme.faint;
            font-size: Theme.fs;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { Tip.text = ""; root.clicked(); }
        changed has-hover => {
            if (self.has-hover && root.tip != "") {
                Tip.x = root.absolute-position.x;
                Tip.top = root.absolute-position.y;
                Tip.bottom = root.absolute-position.y + root.height;
                Tip.text = root.tip;
            } else if (!self.has-hover && Tip.text == root.tip) {
                Tip.text = "";
            }
        }
    }
}

// Single-line input with a prompt-style placeholder.
export component RInput inherits Rectangle {
    in-out property <string> text <=> ti.text;
    in property <string> placeholder;
    in property <bool> password;
    callback accepted(string);
    callback edited();
    forward-focus: ti;
    height: 24px;
    border-width: 1px;
    border-color: ti.has-focus ? Theme.fg : Theme.dim;
    background: Theme.panel;
    ti := TextInput {
        x: 5px;
        width: parent.width - 10px;
        height: parent.height;
        vertical-alignment: center;
        color: Theme.fg;
        selection-background-color: Theme.accent;
        selection-foreground-color: Theme.on-accent;
        font-size: Theme.fs;
        single-line: true;
        input-type: root.password ? InputType.password : InputType.text;
        accepted => { root.accepted(self.text); }
        edited => { root.edited(); }
    }
    Text {
        x: 5px;
        height: parent.height;
        vertical-alignment: center;
        visible: ti.text == "";
        text: root.placeholder;
        color: Theme.faint;
        font-size: Theme.fs;
    }
}

// Status icon: the device's OS inside a monitor, laptop or phone frame,
// tinted by status, with a one-character status badge (PRD PR-6, PR-8).
export component OsIcon inherits Rectangle {
    in property <string> os;
    in property <string> device;
    in property <color> tint;
    in property <string> badge;
    width: 36px;
    height: 28px;

    if root.device == "laptop": Rectangle {
        x: 4px; y: 1px; width: 26px; height: 17px;
        border-width: 1px; border-color: root.tint;
        Text { text: root.os; color: root.tint; font-size: 8px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    }
    if root.device == "laptop": Rectangle { x: 0px; y: 19px; width: 34px; height: 3px; background: root.tint; }

    if root.device == "mobile": Rectangle {
        x: 9px; y: 0px; width: 16px; height: 27px;
        border-width: 1px; border-color: root.tint; border-radius: 3px;
        Text { text: root.os; color: root.tint; font-size: 6px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    }

    if root.device == "group": Rectangle {
        x: 2px; y: 2px; width: 30px; height: 22px;
        Rectangle { x: 0px; y: 4px; width: 12px; height: 12px; border-width: 1px; border-color: root.tint; }
        Rectangle { x: 9px; y: 0px; width: 12px; height: 12px; border-width: 1px; border-color: root.tint; background: Theme.bg; }
        Rectangle { x: 18px; y: 6px; width: 12px; height: 12px; border-width: 1px; border-color: root.tint; background: Theme.bg; }
    }
    if root.device == "notes": Rectangle {
        x: 6px; y: 0px; width: 22px; height: 26px;
        border-width: 1px; border-color: root.tint;
        Text { text: "me"; color: root.tint; font-size: 9px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    }

    if root.device != "laptop" && root.device != "mobile" && root.device != "group" && root.device != "notes": Rectangle {
        x: 2px; y: 0px; width: 30px; height: 19px;
        border-width: 1px; border-color: root.tint;
        Text { text: root.os == "" ? "?" : root.os; color: root.tint; font-size: 8px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    }
    if root.device == "desktop" || root.device == "": Rectangle { x: 14px; y: 19px; width: 6px; height: 4px; background: root.tint; }
    if root.device == "desktop" || root.device == "": Rectangle { x: 9px; y: 23px; width: 16px; height: 1px; background: root.tint; }

    // status badge, bottom-right
    if root.badge != "": Rectangle {
        x: parent.width - 11px; y: parent.height - 11px; width: 11px; height: 11px;
        background: root.tint;
        Text { text: root.badge; color: Theme.bg; font-size: 9px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    }
}

// Checkbox: [x] label
export component RCheck inherits Rectangle {
    in-out property <bool> checked;
    in property <string> text;
    callback toggled(bool);
    height: 20px;
    HorizontalLayout {
        spacing: 6px;
        alignment: start;
        Text { text: root.checked ? "[x]" : "[ ]"; color: root.checked ? Theme.accent : Theme.dim; vertical-alignment: center; horizontal-stretch: 0; }
        Text { text: root.text; color: Theme.fg; vertical-alignment: center; horizontal-alignment: left; font-size: Theme.small; overflow: elide; horizontal-stretch: 1; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// Tab label for panel headers.
export component RTab inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;
    height: 20px;
    background: root.active ? Theme.panel : transparent;
    border-width: root.active ? 1px : 0px;
    border-color: Theme.line;
    HorizontalLayout {
        padding-left: 5px;
        padding-right: 5px;
        Text { text: root.text; color: root.active ? Theme.accent : (ta.has-hover ? Theme.fg : Theme.dim); font-size: Theme.small; vertical-alignment: center; }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Small caption above a group of controls.
export component RCaption inherits Text {
    color: Theme.dim;
    font-size: Theme.small;
}

// Multi-line text input.
export component RArea inherits Rectangle {
    in-out property <string> text <=> ti.text;
    in property <string> placeholder;
    in property <bool> read-only;
    in property <length> font-size: Theme.small;
    forward-focus: ti;
    border-width: 1px;
    border-color: ti.has-focus ? Theme.fg : Theme.dim;
    background: Theme.panel;
    clip: true;
    ti := TextInput {
        x: 4px;
        y: 3px;
        width: parent.width - 8px;
        height: parent.height - 6px;
        single-line: false;
        wrap: char-wrap;
        read-only: root.read-only;
        color: Theme.fg;
        font-size: root.font-size;
        selection-background-color: Theme.accent;
        selection-foreground-color: Theme.on-accent;
    }
    Text {
        x: 4px;
        y: 3px;
        visible: ti.text == "";
        text: root.placeholder;
        color: Theme.faint;
        font-size: root.font-size;
    }
}

// Menu entry for popups.
export component RMenuItem inherits Rectangle {
    in property <string> text;
    in property <color> tone: Theme.fg;
    callback clicked;
    height: 20px;
    background: ta.has-hover ? Theme.hover : transparent;
    Text { x: 6px; height: parent.height; vertical-alignment: center; text: root.text; color: root.tone; font-size: Theme.small; }
    ta := TouchArea { clicked => { root.clicked(); } }
}
